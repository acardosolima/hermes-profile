# Per-device credentials for this Hermes profile.
# Copy to .env and fill in ONLY what this device actually uses.
# None of these are required to install the profile — model.provider/model
# in config.yaml are just a starting default; run `hermes model` or
# `hermes config set model.provider <provider>` after install to point this
# device at whatever provider/key it actually has.

# Anthropic API key (sk-ant-...). Only needed if this device uses
# model.provider=anthropic. Differs per device (e.g. consultancy key vs.
# work key) — never the same value on two machines.
ANTHROPIC_TOKEN=

# Google/Gemini API key. Only needed if this device routes to a Google model.
GOOGLE_API_KEY=

# Slack bot token. Only needed if this device runs the Slack gateway.
# Not set up yet on any device — leave blank until configured.
SLACK_BOT_TOKEN=

# Slack app-level token. Only needed if this device runs the Slack gateway.
# Not set up yet on any device — leave blank until configured.
SLACK_APP_TOKEN=
