[
  {"name": "plain listing", "rule": "none", "tool": "terminal", "args": {"command": "ls -la"}, "expect": "allow"},
  {"name": "echo", "rule": "none", "tool": "terminal", "args": {"command": "echo hello"}, "expect": "allow"},
  {"name": "terminal with a workdir inside the project", "rule": "none", "tool": "terminal", "args": {"command": "ls", "workdir": "{project}"}, "expect": "allow"},
  {"name": "sudo", "rule": "R01", "tool": "terminal", "args": {"command": "sudo apt update"}, "expect": "block"},
  {"name": "write git internals", "rule": "R02", "tool": "write_file", "args": {"path": "{project}/.git/config", "content": "x"}, "expect": "block"},
  {"name": "patch git internals", "rule": "R02", "tool": "patch", "args": {"path": "{project}/.git/config", "old_string": "a", "new_string": "b"}, "expect": "block"},
  {"name": "patch mode names git internals", "rule": "R02", "tool": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n*** Update File: {project}/.git/config\n@@\n-a\n+b\n*** End Patch"}, "expect": "block"},
  {"name": "patch mode moves a file onto git internals", "rule": "R02", "tool": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n*** Move File: notes.txt -> .git/hooks/pre-commit\n*** End Patch"}, "expect": "block"},
  {"name": "redirect into git config", "rule": "R03", "tool": "terminal", "args": {"command": "echo x > .git/config"}, "expect": "block"},
  {"name": "write outside the project", "rule": "R04", "tool": "write_file", "args": {"path": "/etc/hosts", "content": "x"}, "expect": "ask"},
  {"name": "write to a home path", "rule": "R04", "tool": "write_file", "args": {"path": "~/hg-guard-cases-outside.txt", "content": "x"}, "expect": "ask"},
  {"name": "patch mode adds a file outside the project", "rule": "R04", "tool": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n*** Add File: /opt-outside/new.txt\n+x\n*** End Patch"}, "expect": "ask"},
  {"name": "delete with parent traversal", "rule": "R05", "tool": "terminal", "args": {"command": "rm -rf ../.."}, "expect": "ask"},
  {"name": "delete everything by glob", "rule": "R05", "tool": "terminal", "args": {"command": "rm -rf *"}, "expect": "ask"},
  {"name": "delete outside the project", "rule": "RUNTIME_FLOOR", "tool": "terminal", "args": {"command": "rm -rf /home/someone/project"}, "expect": "block"},
  {"name": "delete the home directory", "rule": "RUNTIME_FLOOR", "tool": "terminal", "args": {"command": "rm -rf ~"}, "expect": "block"},
  {"name": "delete the filesystem root", "rule": "RUNTIME_FLOOR", "tool": "terminal", "args": {"command": "rm -rf /"}, "expect": "block"},
  {"name": "relative delete from the filesystem root", "rule": "cwd", "tool": "terminal", "args": {"command": "rm -rf home", "workdir": "/"}, "expect": "unjudgeable"},
  {"name": "relative delete from a system directory", "rule": "cwd", "tool": "terminal", "args": {"command": "rm -rf ssl", "workdir": "/etc"}, "expect": "unjudgeable"},
  {"name": "force push", "rule": "R06", "tool": "terminal", "args": {"command": "git push --force origin feature"}, "expect": "block"},
  {"name": "force push short flag", "rule": "R06", "tool": "terminal", "args": {"command": "git push -f origin feature"}, "expect": "block"},
  {"name": "read a dotenv file (upstream warns only)", "rule": "R09", "tool": "read_file", "args": {"path": "{project}/.env"}, "expect": "allow"},
  {"name": "bypass hooks flag", "rule": "R10", "tool": "terminal", "args": {"command": "git commit --no-verify -m x"}, "expect": "block"},
  {"name": "bypass signing flag", "rule": "R10", "tool": "terminal", "args": {"command": "git commit --no-gpg-sign -m x"}, "expect": "block"},
  {"name": "hard reset on main", "rule": "R11", "tool": "terminal", "args": {"command": "git reset --hard origin/main"}, "expect": "block"},
  {"name": "direct push to main", "rule": "R12", "tool": "terminal", "args": {"command": "git push origin main"}, "expect": "ask"},
  {"name": "stage a dotenv file", "rule": "R15", "tool": "terminal", "args": {"command": "git add .env"}, "expect": "block"},
  {"name": "cat a dotenv file", "rule": "RUNTIME_FLOOR", "tool": "terminal", "args": {"command": "cat .env"}, "expect": "block"},
  {"name": "process input is judged", "rule": "R01", "tool": "process_manage", "args": {"action": "submit", "session_id": "s", "data": "sudo ls"}, "expect": "block"},
  {"name": "process listing is not guarded", "rule": "none", "tool": "process_manage", "args": {"action": "list"}, "expect": "unguarded"},
  {"name": "write inside the project", "rule": "none", "tool": "write_file", "args": {"path": "{project}/notes.txt", "content": "x"}, "expect": "allow"},
  {"name": "patch inside the project", "rule": "none", "tool": "patch", "args": {"path": "{project}/notes.txt", "old_string": "a", "new_string": "b"}, "expect": "allow"},
  {"name": "read a normal file", "rule": "none", "tool": "read_file", "args": {"path": "{project}/notes.txt"}, "expect": "allow"},
  {"name": "unguarded tool passes through", "rule": "none", "tool": "todo", "args": {"items": []}, "expect": "unguarded"},
  {"name": "terminal without a command", "rule": "malformed", "tool": "terminal", "args": {}, "expect": "unjudgeable"},
  {"name": "terminal command is not a string", "rule": "malformed", "tool": "terminal", "args": {"command": 5}, "expect": "unjudgeable"},
  {"name": "write without content", "rule": "malformed", "tool": "write_file", "args": {"path": "{project}/a.txt"}, "expect": "unjudgeable"},
  {"name": "patch that names no file", "rule": "malformed", "tool": "patch", "args": {"mode": "patch", "patch": "nothing useful"}, "expect": "unjudgeable"},
  {"name": "patch call without path or patch", "rule": "malformed", "tool": "patch", "args": {"old_string": "a", "new_string": "b"}, "expect": "unjudgeable"},
  {"name": "tilde user path", "rule": "malformed", "tool": "write_file", "args": {"path": "~root/x.txt", "content": "x"}, "expect": "unjudgeable"},
  {"name": "edit the project policy file", "rule": "guard", "tool": "write_file", "args": {"path": "{project}/harness.toml", "content": "x"}, "expect": "refused"},
  {"name": "touch the guard through the shell", "rule": "guard", "tool": "terminal", "args": {"command": "echo x >> plugins/harness-guard/adapter.py"}, "expect": "refused"},
  {"name": "switch the guard off with the hermes cli", "rule": "guard", "tool": "terminal", "args": {"command": "hermes plugins disable harness-guard"}, "expect": "refused"},
  {"name": "change hermes settings with the cli", "rule": "guard", "tool": "terminal", "args": {"command": "hermes config set approvals.mode off"}, "expect": "refused"},
  {"name": "patch header without a space", "rule": "R04", "tool": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n***Add File: /opt-outside/new.txt\n+x\n*** End Patch"}, "expect": "ask"},
  {"name": "patch header the guard cannot read", "rule": "malformed", "tool": "patch", "args": {"mode": "patch", "patch": "*** Begin Patch\n*** Update File: a.txt\n*** Frobnicate File: /etc/hosts\n*** End Patch"}, "expect": "unjudgeable"},
  {"name": "read the hermes config through the shell", "rule": "guard", "tool": "terminal", "args": {"command": "cat ~/.hermes/config.yaml"}, "expect": "refused"},
  {"name": "edit hermes plugins through an environment variable", "rule": "guard", "tool": "terminal", "args": {"command": "echo x >> $HERMES_HOME/plugins/y.py"}, "expect": "refused"},
  {"name": "hermes cli with a flag before the subcommand", "rule": "guard", "tool": "terminal", "args": {"command": "hermes --profile=work config show"}, "expect": "refused"},
  {"name": "mention the guard name inside file content", "rule": "none", "tool": "write_file", "args": {"path": "{project}/notes2.txt", "content": "docs about harness-guard"}, "expect": "allow"},
  {"name": "absolute workdir inside the project", "rule": "none", "tool": "terminal", "args": {"command": "ls", "workdir": "{project}"}, "expect": "allow"}
]
