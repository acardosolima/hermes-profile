# Bash reads LF on Linux, macOS, and Windows. CRLF makes the same script fail
# on all three. Git on Windows would otherwise check these out as CRLF, and
# profile install copies the working tree. Last match wins: the harness rule
# below still keeps generated bytes untouched.
*.sh text eol=lf
skills/software-development/git-multi-identity/scripts/githooks/** text eol=lf

# Generated skills must keep their bytes on every platform.
skills/harness/** -text
